@inject NavigationManager Nav

<nav class="nav">
    <a class="nav-item @(IsActive("/") ? "active" : "")" href="/">Home</a>
    <a class="nav-item @(IsActive("/claim-timers") ? "active" : "")" href="/claim-timers">Claim Timers</a>
    <a class="nav-item @(IsActive("/outpost") ? "active" : "")" href="/outpost">Outpost</a>
    <a class="nav-item @(IsActive("/lootables") ? "active" : "")" href="/lootables">Lootables</a>
    <a class="nav-item @(IsActive("/components") ? "active" : "")" href="/components">Components</a>
</nav>

@code {
    private bool IsActive(string basePath)
    {
        // Current path without query string or hash
        var current = Nav.ToBaseRelativePath(Nav.Uri);
        var currentPath = "/" + current.Split('?', '#')[0].Trim('/');

        // Normalize root
        if (string.IsNullOrWhiteSpace(currentPath))
            currentPath = "/";

        // Exact match (Home case)
        if (string.Equals(currentPath, basePath, StringComparison.OrdinalIgnoreCase))
            return true;

        // Section match: /outpost matches /outpost/*
        if (basePath != "/" &&
            currentPath.StartsWith(basePath + "/", StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

}
