@inject ChapterAndVerse.Domain.LootablesAPI Api
@page "/lootables_orginal"
@attribute [StreamRendering]

<PageTitle>Lootables</PageTitle>

<h1>Lootables</h1>

<>Context Menu</>
<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Add
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> List
            </NavLink>
        </div>
    </nav>
</div>

@if (lootItems == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Item Type</th>
                <th>Sub Type</th>
                <th>Name</th>
                <th aria-label="Amount of uSCU the item takes">Size</th>
                <th aria-label="Amount the item sells for at cargor centers">Sell value</th>
                <th>Return</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lootitem in lootItems)
            {
                <tr>
                    <td>@lootitem.ItemTypeName</td>
                    <td>@lootitem.SubItemTypeName</td>
                    <td>@lootitem.ItemName</td>
                    <td>@lootitem.SCUSize</td>
                    <td>@lootitem.CargoSaleValue</td>
                    <td>@lootitem.Return</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<PiStarDTO.LootItemDTO>? lootItems;

    protected override async Task OnInitializedAsync()
    {
        lootItems = await Api.GetLootableItems();
    }
}
